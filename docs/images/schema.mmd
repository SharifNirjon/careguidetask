    documents ||--o{ chunks : "indexed as"
    documents |o--o{ documents : "duplicate_of"
    processing_jobs ||--o{ processing_events : "logs"
    processing_jobs |o--o{ extractions : "produced"
    document_units ||--o{ chunks : "split into"
