# --- docker-compose `db` service ---
POSTGRES_USER=careguide
POSTGRES_PASSWORD=careguide
POSTGRES_DB=careguide
POSTGRES_PORT=5432

# --- application database ---
# SQLAlchemy URL; the +psycopg driver (psycopg 3) is used for API and workers.
DATABASE_URL=postgresql+psycopg://careguide:careguide@localhost:5432/careguide
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_S=1800
DB_STATEMENT_TIMEOUT_MS=30000

# --- tests ---
# The test suite creates/drops databases named <db>_test and <db>_migrations_test
# on this server, so the user needs CREATEDB.
TEST_DATABASE_URL=postgresql+psycopg://careguide:careguide@localhost:5432/careguide_test

# --- pipeline (all PipelineSettings fields can be overridden; see docs/pipeline.md) ---
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./data/storage
MAX_FILE_SIZE_MB=100
MAX_PAGES=2000
PAGE_BATCH_SIZE=25
OCR_DPI=300
MIN_DIGITAL_CHARS=50
OCR_LANGS=eng
OCR_PAGE_TIMEOUT_S=60
MAX_IMAGE_PIXELS=180000000
MAX_SHEET_ROWS=200000
MAX_UNIT_TEXT_CHARS=200000
MAX_FAILED_UNIT_RATIO=0.2
STORE_LAYOUT=true
# Tesseract: one OpenMP thread per process (workers provide the parallelism)
OMP_THREAD_LIMIT=1

# --- LLM gateway (OpenRouter). The key is a SECRET: set it in .env only. ---
# Free NVIDIA endpoints may log traffic: use synthetic/public documents only.
OPENROUTER_API_KEY=
LLM_PRIMARY_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
LLM_FALLBACK_MODELS=[]
LLM_REASONING_EFFORT=low
LLM_READ_TIMEOUT_S=240
FREE_MODEL_RPM=18
FREE_MODEL_DAILY_LIMIT=50
EMBED_BATCH_SIZE=32
MAX_PROMPT_CHARS=60000
GROUNDING_MIN_SCORE=0.85
# Live LLM tests (spend real quota): RUN_LIVE_LLM=1 pytest -m live
RUN_LIVE_LLM=0

# --- validation (see docs/validation.md; lists/dicts are JSON) ---
VALIDATION_REL_TOL=0.005
FIELD_CONFIDENCE_MIN=0.6
OVERALL_CONFIDENCE_MIN=0.7
AUTO_APPROVE_MIN=0.85
MAX_TAX_RATE=0.5
FUTURE_DATE_GRACE_DAYS=7
MAX_INVOICE_AGE_YEARS=5
SUPPLIER_MATCH_MIN=0.8
DUPLICATE_DATE_WINDOW_DAYS=3
BLOCKING_WARNINGS=["UNGROUNDED_VALUE","LOW_CONFIDENCE","POSSIBLE_DUPLICATE"]
DISABLED_RULES=[]
SEVERITY_OVERRIDES={}
